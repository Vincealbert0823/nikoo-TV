    <!-- SETTINGS & SYSTEM MANAGEMENT MODAL (Smart TV & Multi-Device Hub) -->
    <div id="settings-modal" class="smartone-modal">
        <div class="modal-card">
            <div class="modal-header">
                <div class="modal-header-title">
                    <i class="fa-solid fa-sliders" style="color:var(--primary-color); font-size:1.4rem;"></i>
                    <div>
                        <h3>Roch TV System Management</h3>
                        <span class="modal-subtitle">Smart TV (VIDAA, Tizen, webOS), Streaming Engine & Network
                            Setup</span>
                    </div>
                </div>
                <button class="modal-close-btn" onclick="closeSettingsModal()" title="Close (ESC / Remote Back)"><i
                        class="fa-solid fa-xmark"></i></button>
            </div>

            <!-- Tab Navigation Bar -->
            <div class="mgmt-tab-bar">
                <button type="button" class="mgmt-tab active" id="tab-btn-display" onclick="switchMgmtTab('display')">
                    <i class="fa-solid fa-palette"></i> Display & Theme
                </button>
                <button type="button" class="mgmt-tab" id="tab-btn-tv" onclick="switchMgmtTab('tv')">
                    <i class="fa-solid fa-tv"></i> Smart TV & Remote
                </button>
                <button type="button" class="mgmt-tab" id="tab-btn-storage" onclick="switchMgmtTab('storage')">
                    <i class="fa-solid fa-database"></i> Storage & Health
                </button>
            </div>

            <div class="modal-body">
                <!-- TAB 1: DISPLAY & THEME -->
                <div id="mgmt-tab-display" class="mgmt-tab-content active">
                    <div class="setting-group">
                        <label class="setting-label"><i class="fa-solid fa-swatchbook"></i> Color Theme Preset</label>
                        <p class="setting-hint">Select your preferred accent styling for cards and UI components:</p>
                        <div class="theme-options">
                            <button type="button" class="theme-btn theme-gold active" onclick="setTheme('gold')">
                                <span class="theme-preview" style="background: #e5a93b;"></span> Cinema Gold
                            </button>
                            <button type="button" class="theme-btn theme-ocean" onclick="setTheme('ocean')">
                                <span class="theme-preview" style="background: #38bdf8;"></span> Ocean Cyan
                            </button>
                            <button type="button" class="theme-btn theme-purple" onclick="setTheme('purple')">
                                <span class="theme-preview" style="background: #a78bfa;"></span> Cinema Violet
                            </button>
                            <button type="button" class="theme-btn theme-emerald" onclick="setTheme('emerald')">
                                <span class="theme-preview" style="background: #34d399;"></span> Emerald Mint
                            </button>
                        </div>
                    </div>

                    <div class="setting-group" style="margin-top: 14px;">
                        <label class="setting-label"><i class="fa-solid fa-circle-half-stroke"></i> Panel Glass
                            Transparency</label>
                        <div class="slider-wrapper">
                            <input type="range" id="transparency-slider" min="30" max="95" value="75"
                                oninput="updateTransparency(this.value)">
                            <span id="transparency-value">75%</span>
                        </div>
                    </div>
                </div>

                <!-- TAB 3: SMART TV & REMOTE SETUP -->
                <div id="mgmt-tab-tv" class="mgmt-tab-content">
                    <div class="setting-group">
                        <label class="setting-label"><i class="fa-solid fa-microchip"></i> Detected Smart TV
                            System</label>
                        <div class="account-summary-box">
                            <div class="account-row"><span>Platform Environment:</span> <strong id="detected-tv-os"
                                    style="color:var(--primary-color);">Detecting...</strong></div>
                            <div class="account-row"><span>Spatial D-Pad Engine:</span> <span
                                    class="badge-status-ok">Active (Tizen, VIDAA, webOS, Android)</span></div>
                            <div class="account-row"><span>Hardware Video Decoder:</span> <span
                                    id="hw-decode-status">Supported</span></div>
                        </div>
                    </div>

                    <div class="setting-group" style="margin-top: 14px;">
                        <label class="setting-label"><i class="fa-solid fa-play"></i> Video Player Engine</label>
                        <p class="setting-hint">Select the best streaming decoder engine for your TV model:</p>
                        <select id="tv-player-engine-select" onchange="changePlayerEngine(this.value)"
                            style="width:100%; padding:10px 14px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:10px; color:#fff; font-size:0.85rem; margin-top:6px; outline:none;">
                            <option value="auto">Auto-Detect (Smart TV Hardware Optimized - Recommended)</option>
                            <option value="native">Native TV Hardware Decoder (Best for Samsung Tizen & LG webOS)
                            </option>
                            <option value="hls">HLS.js JavaScript Engine (Best for VIDAA OS & Android TV)</option>
                            <option value="direct">Direct Stream Mode (Raw Passthrough)</option>
                        </select>
                    </div>

                    <div class="setting-group apk-download-target"
                        style="margin-top: 14px; background: rgba(34, 197, 94, 0.08); border: 1px solid rgba(34, 197, 94, 0.25); border-radius: 12px; padding: 14px;">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <div>
                                <label class="setting-label" style="color:#4ade80; margin:0;"><i
                                        class="fa-brands fa-android"></i> Android TV APK Edition</label>
                                <p class="setting-hint" style="margin:4px 0 0 0;">Download native TV app for FireStick,
                                    Sony, TCL & Android TV boxes:</p>
