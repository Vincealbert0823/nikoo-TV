<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Roch TV</title>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <!-- Apple iOS Web App & PWA Standalone Support (All iOS Versions) -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Roch TV">
    <link rel="apple-touch-icon" href="img/roch.png">
    <link rel="apple-touch-icon" sizes="180x180" href="img/roch.png">
    <link rel="manifest" href="manifest.json">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#060911">

    <!-- Cache Control -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="css/style.css?v=65">
    <script>
        // Force JS reload
        const appVersion = 65;
    </script>
</head>

<body>

    <!-- LIVE BROADCAST MARQUEE TICKER BANNER -->
    <div id="live-broadcast-ticker" class="broadcast-ticker-banner" style="display:none;">
        <div class="ticker-badge" id="ticker-badge-container">
            <i class="fa-solid fa-bullhorn fa-beat-fade"></i>
            <span id="ticker-badge-text">ANNOUNCEMENT</span>
        </div>
        <div class="ticker-track">
            <div class="ticker-content" id="ticker-marquee-text"></div>
        </div>
        <div class="ticker-timer" id="ticker-timer-display" style="display:none;">
            <i class="fa-regular fa-clock"></i> <span id="ticker-countdown"></span>
        </div>
        <button type="button" class="ticker-close-btn" onclick="dismissBroadcastTicker()" title="Dismiss announcement">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <!-- DEVICE SECURITY LOCKOUT SCREEN -->
    <div id="device-lockout-screen" class="lockout-screen" style="display:none;">
        <div class="lockout-backdrop"></div>
        <div class="lockout-card">
            <div class="lockout-icon-box">
                <i id="lockout-icon" class="fa-solid fa-shield-halved"></i>
            </div>
            <div class="lockout-badge" id="lockout-badge-status">UNAUTHORIZED DEVICE</div>
            <h2 id="lockout-headline" class="lockout-title">Device Not Activated</h2>
            <p id="lockout-message" class="lockout-desc">
                This streaming device has not been activated by the master administrator. Provide your MAC Address to
                activate your subscription.
            </p>
            <div class="lockout-info-box">
                <div class="mac-spotlight-card">
                    <div class="mac-spotlight-header">
                        <span class="mac-spotlight-label"><i class="fa-solid fa-network-wired"></i> Your MAC
                            Address:</span>
                        <button type="button" class="btn-copy-chip" onclick="copyDeviceMac()" id="btn-copy-mac"
                            title="Copy MAC Address">
                            <i class="fa-regular fa-copy"></i> <span>Copy</span>
                        </button>
                    </div>
                    <div class="mac-spotlight-value" id="lockout-display-mac">Detecting...</div>
                </div>
                <div class="device-details-list">
                    <div class="device-detail-row">
                        <span class="detail-label">Device ID:</span>
                        <strong class="detail-value" id="lockout-display-devid">Detecting...</strong>
                    </div>
                    <div class="device-detail-row">
                        <span class="detail-label">Platform:</span>
                        <span class="detail-value" id="lockout-display-platform">Smart TV</span>
                    </div>
                </div>
            </div>
            <div class="lockout-action-row"
                style="display:flex; flex-direction:column; gap:10px; width:100%; max-width:440px; margin:0 auto;">
                <button type="button" class="btn-lockout-retry btn-lockout-primary" id="btn-lockout-signin"
                    onclick="openLoginFromLockout()"
                    style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); border: 1px solid #38bdf8; color:#ffffff; font-weight:800; font-size:1rem; padding:13px 20px; width:100%; justify-content:center; box-shadow: 0 4px 18px rgba(2, 132, 199, 0.45);">
                    <i class="fa-solid fa-right-to-bracket"></i> Sign In with Username &amp; Password
                </button>
                <div style="display:flex; gap:10px; width:100%; justify-content:center; flex-wrap:wrap;">
                    <button type="button" class="btn-lockout-retry" onclick="retrySecurityHandshake()"
                        style="flex:1; justify-content:center; font-size:0.85rem; padding:10px 14px;">
                        <i class="fa-solid fa-rotate"></i> Check Activation
                    </button>
                    <button type="button" class="btn-lockout-retry" onclick="openRedeemGiftCodePrompt()"
                        style="background:#ec4899; border: 1px solid #f472b6; flex:1; justify-content:center; font-size:0.85rem; padding:10px 14px; color:#fff;">
                        <i class="fa-solid fa-gift"></i> Redeem Gift Code
                    </button>
                </div>
            </div>
            <div class="lockout-footer-note">
                Roch TV Security Protection &copy; 2026 • license by:ichiban_kuriosaki
            </div>
        </div>
    </div>

    <!-- LOGIN SCREEN (ROCH TV CINEMA PORTAL) -->
    <div id="login-screen" class="screen active">
        <div class="login-overlay"></div>
        <div class="login-ambient-glow"></div>

        <!-- FLOATING FROSTED GLASS HEADER -->
        <header class="roch-navbar">
            <div class="roch-nav-brand">
                <img src="img/roch.png" alt="Roch TV" class="roch-brand-logo" onerror="this.src='img/pbb.png'">
                <div class="roch-brand-meta">
                    <span class="roch-brand-name">ROCH <span class="accent-text">TV</span></span>
                    <span class="roch-node-pill"><span class="node-pulse-dot"></span> 4K CLOUD STREAM</span>
                </div>
            </div>

            <div class="roch-nav-actions">
                <!-- COMPACT 1-LINE SMART TV BADGE -->
                <div class="header-smart-tv-badge-compact" id="header-smart-tv-badge"
                    title="Samsung (Tizen) & LG (webOS) stream directly through this web browser with zero installation!">
                    <div class="compact-tv-icon"><i class="fa-solid fa-tv"></i></div>
                    <div class="compact-tv-text">
                        <span class="tag-bold">Smart TV:</span>
                        <span class="tag-desc">Direct Web Play</span>
                    </div>
                </div>

                <!-- DEDICATED APPLE iOS BUTTON IN HEADER -->
                <div class="header-ios-badge-wrap" id="header-ios-badge-wrap">
                    <button type="button" class="btn-header-ios" id="btn-header-ios" onclick="openIosInstallModal()"
                        title="Apple iOS (iPhone, iPad & Apple TV): Web App & App Store Player">
                        <i class="fa-brands fa-apple"></i>
                        <span id="header-ios-text">Apple iOS</span>
                    </button>
                </div>

                <!-- UNIFIED DOWNLOAD DROPDOWN -->
                <div class="header-download-dropdown-wrap apk-download-target">
                    <button type="button" class="btn-header-download-dropdown" id="btn-header-download"
                        onclick="toggleDownloadDropdown(event)" aria-expanded="false">
                        <i class="fa-solid fa-download"></i>
                        <span>Apps</span>
                        <i class="fa-solid fa-chevron-down drop-arrow" id="drop-arrow-icon"></i>
                    </button>
                    <div class="header-download-menu" id="header-download-menu">
                        <div class="menu-header">Available Clients &amp; Apps</div>
                        <a href="downloads/roch-tv.apk" class="download-menu-item" download
                            title="Download APK for Android TV, Google TV & Firestick">
                            <div class="menu-item-icon tv"><i class="fa-solid fa-tv"></i></div>
                            <div class="menu-item-info">
                                <span class="menu-item-title">Android TV &amp; Firestick</span>
                                <span class="menu-item-desc">Leanback APK for Smart TV &amp; Boxes</span>
                            </div>
                            <i class="fa-solid fa-arrow-down-to-bracket menu-action-icon"></i>
                        </a>
                        <a href="downloads/roch-highend.apk" class="download-menu-item" download
                            title="Download APK for Android Mobile">
                            <div class="menu-item-icon mobile"><i class="fa-solid fa-bolt"></i></div>
                            <div class="menu-item-info">
                                <span class="menu-item-title">Android Mobile</span>
                                <span class="menu-item-desc">Hardware-accelerated mobile edition</span>
                            </div>
                            <i class="fa-solid fa-arrow-down-to-bracket menu-action-icon"></i>
                        </a>
                        <a href="#" onclick="openIosInstallModal(); toggleDownloadDropdown(event); return false;"
                            class="download-menu-item" title="Universal iOS Web App &amp; App Store Player">
                            <div class="menu-item-icon ios"><i class="fa-brands fa-apple"></i></div>
                            <div class="menu-item-info">
                                <span class="menu-item-title">Apple iOS (iPhone &amp; iPad)</span>
                                <span class="menu-item-desc">Universal Web App &amp; App Store setup</span>
                            </div>
                            <i class="fa-solid fa-chevron-right menu-action-icon" style="color:#ffffff;"></i>
                        </a>
                    </div>
                </div>

                <!-- CONTROLLER PORTAL LINK -->

            </div>
        </header>

        <!-- MAIN CINEMA CENTERPIECE STAGE -->
        <main class="roch-login-stage">
            <div class="roch-hero-header">
                <div class="roch-hero-tag">
                    <i class="fa-solid fa-satellite-dish"></i>
                    <span>ROCH TV ENTERTAINMENT CLOUD</span>
                </div>
                <h1 class="roch-hero-title">Television <span class="neon-gradient-text">Reimagined.</span></h1>
                <p class="roch-hero-subtitle">
                    Live global channels, cinematic 4K blockbusters, and episodic boxsets with zero buffering.
                </p>
            </div>

            <!-- LUXURY GLASS PORTAL CARD -->
            <div class="roch-portal-card">
                <!-- SEGMENTED TAB SWITCHER -->
                <div class="roch-card-tabs">
                    <button type="button" class="roch-tab-btn active" id="tab-btn-account"
                        onclick="switchLoginMode('account')">
                        <i class="fa-solid fa-key"></i>
                        <span>Sign In</span>
                    </button>
                    <button type="button" class="roch-tab-btn" id="tab-btn-voucher"
                        onclick="switchLoginMode('voucher')">
                        <i class="fa-solid fa-gift"></i>
                        <span>Redeem Voucher</span>
                    </button>
                </div>

                <!-- Hidden MAC container for background script compatibility -->
                <span id="login-display-mac" style="display:none;"></span>

                <!-- TAB 1: XTREAM LINE LOGIN FORM -->
                <div id="login-view-account" class="login-tab-content">
                    <div id="unactivated-login-tip"
                        style="display:none; background: rgba(56, 189, 248, 0.14); border: 1px solid rgba(56, 189, 248, 0.35); border-radius: 8px; padding: 10px 14px; margin-bottom: 14px; font-size: 0.82rem; color: #bae6fd; text-align: center; line-height: 1.4;">
                        <i class="fa-solid fa-circle-check" style="color:#38bdf8; margin-right:4px;"></i>
                        <strong>Activation by Account:</strong> Sign in with your IPTV username &amp; password to
                        authorize and activate this device automatically!
                    </div>
                    <form id="login-form">
                        <div class="roch-field-group">
                            <label class="roch-field-label" for="username">Username</label>
                            <div class="roch-input-wrap">
                                <i class="fa-solid fa-user roch-input-icon icon-cyan"></i>
                                <input type="text" id="username" class="roch-input" placeholder="e.g. vip_user"
                                    autocomplete="username" required>
                            </div>
                        </div>

                        <div class="roch-field-group">
                            <label class="roch-field-label" for="password">Password</label>
                            <div class="roch-input-wrap">
                                <i class="fa-solid fa-lock roch-input-icon icon-indigo"></i>
                                <input type="password" id="password" class="roch-input" placeholder="••••••••"
                                    autocomplete="current-password" required>
                                <button type="button" class="roch-eye-toggle" onclick="togglePasswordVisibility()"
                                    title="Show/Hide Password">
                                    <i class="fa-solid fa-eye" id="toggle-password-icon"></i>
                                </button>
                            </div>
                        </div>

                        <div class="roch-form-row">
                            <label class="roch-checkbox-label">
                                <input type="checkbox" id="remember-me-check" checked>
                                <span class="custom-checkbox"></span>
                                <span>Remember session</span>
                            </label>
                            <a href="#" class="roch-help-link"
                                onclick="alert('Please contact your administrator to activate or renew your subscription.'); return false;">
                                Need help?
                            </a>
                        </div>

                        <button type="submit" class="btn-roch-glow-launch" id="btn-login-submit">
                            <span class="btn-launch-glow-line"></span>
                            <i class="fa-solid fa-play"></i>
                            <span>Start Streaming</span>
                            <i class="fa-solid fa-arrow-right btn-launch-arrow"></i>
                        </button>
                    </form>

                    <!-- View Device MAC & Activation Status Link -->
                    <div style="text-align:center; margin-top:8px;">
                        <a href="javascript:void(0)" onclick="openLockoutFromLogin()"
                            style="color:#94a3b8; font-size:0.75rem; text-decoration:none; display:inline-flex; align-items:center; gap:6px; transition:color 0.2s;"
                            onmouseover="this.style.color='#38bdf8'" onmouseout="this.style.color='#94a3b8'">
                            <i class="fa-solid fa-shield-halved" style="color:#38bdf8;"></i>
                            <span>Need MAC Address? View Device Activation Info</span>
                        </a>
                    </div>
                </div>

                <!-- TAB 2: INSTANT GIFT CODE / VOUCHER REDEEM -->
                <div id="login-view-voucher" class="login-tab-content" style="display:none;">
                    <div class="voucher-inner-box">
                        <div class="voucher-card-lead">
                            <div class="voucher-icon-orb"><i class="fa-solid fa-gift"></i></div>
                            <div class="voucher-lead-text">
                                <strong>Instant Gift Code Activation</strong>
                                <span>Redeem a voucher to unlock access on this device immediately.</span>
                            </div>
                        </div>

                        <div class="roch-field-group">
                            <label class="roch-field-label" for="card-voucher-code">Subscription Voucher Code</label>
                            <div class="roch-input-wrap">
                                <i class="fa-solid fa-ticket roch-input-icon icon-pink"></i>
                                <input type="text" id="card-voucher-code" class="roch-input voucher-code-input"
                                    placeholder="ROCH-VIP-XXXX-XXXX" autocomplete="off" autocapitalize="characters">
                            </div>
                        </div>

                        <button type="button" class="btn-roch-glow-launch btn-pink-glow"
                            onclick="submitDirectCardVoucher()">
                            <i class="fa-solid fa-bolt"></i>
                            <span>Activate Subscription</span>
                        </button>

                        <button type="button" class="btn-back-to-login" onclick="switchLoginMode('account')">
                            <i class="fa-solid fa-arrow-left"></i> Return to Account Sign In
                        </button>
                    </div>
                </div>

                <!-- CLIENT APPS LAUNCH DOCK -->
                <div class="roch-app-dock apk-download-target">
                    <div class="dock-divider">
                        <span>OR STREAM VIA NATIVE CLIENT APPS</span>
                    </div>
                    <div class="dock-grid">
                        <a href="downloads/roch-tv.apk" class="dock-btn dock-tv" download
                            title="Android TV & Firestick APK">
                            <i class="fa-solid fa-tv"></i>
                            <div class="dock-text">
                                <span class="dock-name">Android TV</span>
                                <span class="dock-sub">Firestick APK</span>
                            </div>
                        </a>
                        <a href="downloads/roch-highend.apk" class="dock-btn dock-mobile" download
                            title="Android Mobile APK">
                            <i class="fa-solid fa-bolt"></i>
                            <div class="dock-text">
                                <span class="dock-name">Mobile APK</span>
                                <span class="dock-sub">Android 14+</span>
                            </div>
                        </a>
                        <a href="#" onclick="openIosInstallModal(); return false;" class="dock-btn dock-ios"
                            title="Apple iOS WebClip & App">
                            <i class="fa-brands fa-apple"></i>
                            <div class="dock-text">
                                <span class="dock-name">Apple iOS</span>
                                <span class="dock-sub">WebClip &amp; App</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <!-- FLOATING SPECIFICATION PILLS -->
            <div class="roch-spec-strip">
                <div class="spec-pill"><i class="fa-solid fa-bolt text-cyan"></i> <span>Sub-Second Zap</span></div>
                <div class="spec-pill"><i class="fa-solid fa-tv text-indigo"></i> <span>4K HDR 60fps</span></div>
                <div class="spec-pill"><i class="fa-solid fa-volume-high text-pink"></i> <span>Dolby 5.1 Surround</span>
                </div>
                <div class="spec-pill"><i class="fa-solid fa-shield-halved text-emerald"></i> <span>Hardware Lock</span>
                </div>
            </div>

            <!-- FOOTER COPYRIGHT & LICENSE -->
            <footer class="roch-stage-footer">
                <span>Roch TV Cloud Platform &copy; 2026 &bull; <span class="license-highlight"><i
                            class="fa-solid fa-certificate"></i> license by:
                        <strong>ichiban_kuriosaki</strong></span></span>
            </footer>
        </main>
    </div>

    <!-- DASHBOARD SCREEN (Multi-Theme Controller Supported) -->
    <div id="dashboard-screen" class="screen">

        <!-- ================= THEME 1: MODERN CINEMA (SMARTONE STYLE) ================= -->
        <div id="theme1-dashboard-view" class="theme-dashboard-layout theme1-layout">
            <div class="dashboard-bg">
                <canvas id="fiber-canvas" class="dashboard-canvas"></canvas>
            </div>
            <div class="dashboard-overlay-gradient"></div>

            <!-- SmartOne Top Header -->
            <header class="smartone-header">
                <div class="smartone-brand">
                    <img src="img/roch.png" alt="Roch TV" class="smartone-logo" onerror="this.src='img/pbb.png'">
                    <div class="smartone-datetime">
                        <span id="smart-time" class="smart-time">--:--:--</span>
                        <span id="smart-date" class="smart-date">Loading...</span>
                    </div>
                </div>

                <div class="smartone-account-badge">
                    <div class="badge-item user-info">
                        <i class="fa-solid fa-user-shield"></i>
                        <span>User: <strong id="display-user">Guest</strong></span>
                    </div>
                    <div class="badge-item status-info">
                        <span class="status-dot"></span>
                        <span id="account-status">Active</span>
                    </div>
                    <div class="badge-item expiry-info">
                        <i class="fa-regular fa-clock"></i>
                        <span>Exp: <strong id="expiry-date">Unlimited</strong></span>
                    </div>
                </div>

                <div class="smartone-header-actions">
                    <button class="smartone-btn" onclick="toggleFullscreen()" title="Toggle Fullscreen (TV Mode)"><i
                            class="fa-solid fa-expand"></i><span>Fullscreen</span></button>
                    <button class="smartone-btn" onclick="openFavorites()" title="Favorites"><i class="fa-solid fa-star"
                            style="color: var(--primary-color);"></i><span>Favorites</span></button>
                    <button class="smartone-btn" onclick="openSettingsModal()" title="Settings"><i
                            class="fa-solid fa-sliders"></i><span>Settings</span></button>
                    <button class="smartone-btn" onclick="reloadPlaylist()" title="Reload Playlist"><i
                            class="fa-solid fa-rotate"></i><span>Reload</span></button>
                    <button class="smartone-btn btn-logout" onclick="logout()" title="Logout"><i
                            class="fa-solid fa-power-off"></i><span>Logout</span></button>
                </div>
            </header>

            <!-- SmartOne Main Cards Grid (Live TV, Movies, Series) -->
            <div class="smartone-dashboard-container">
                <div class="smartone-cards-grid">
                    <!-- LIVE TV -->
                    <div class="smartone-card card-livetv" tabindex="0" onclick="openSection('Live TV')">
                        <div class="card-glow-layer"></div>
                        <div class="card-badge live"><span class="pulse-dot"></span> LIVE</div>
                        <div class="card-icon-box">
                            <i class="fa-solid fa-satellite-dish"></i>
                        </div>
                        <div class="card-body">
                            <h3 class="card-title">LIVE TV</h3>
                            <p class="card-desc">Live Broadcasts & EPG Channels</p>
                            <div class="card-meta"><i class="fa-solid fa-tower-broadcast"></i> <span>Digital Cable &
                                    Satellite</span></div>
                        </div>
                        <div class="card-footer-action">
                            <span>View Channels</span> <i class="fa-solid fa-arrow-right"></i>
                        </div>
                    </div>

                    <!-- MOVIES (VOD) -->
                    <div class="smartone-card card-movies" tabindex="0" onclick="openSection('Movies')">
                        <div class="card-glow-layer"></div>
                        <div class="card-badge vod">VOD</div>
                        <div class="card-icon-box">
                            <i class="fa-solid fa-film"></i>
                        </div>
                        <div class="card-body">
                            <h3 class="card-title">MOVIES</h3>
                            <p class="card-desc">Feature Films & Video On Demand</p>
                            <div class="card-meta"><i class="fa-solid fa-film"></i> <span>4K UHD & 1080p Cinema</span>
                            </div>
                        </div>
                        <div class="card-footer-action">
                            <span>Browse Library</span> <i class="fa-solid fa-arrow-right"></i>
                        </div>
                    </div>

                    <!-- SERIES -->
                    <div class="smartone-card card-series" tabindex="0" onclick="openSection('Series')">
                        <div class="card-glow-layer"></div>
                        <div class="card-badge series">SERIES</div>
                        <div class="card-icon-box">
                            <i class="fa-solid fa-tv"></i>
                        </div>
                        <div class="card-body">
                            <h3 class="card-title">SERIES</h3>
                            <p class="card-desc">Television Shows, Boxsets & Seasons</p>
                            <div class="card-meta"><i class="fa-solid fa-layer-group"></i> <span>Complete Episodic
                                    Content</span></div>
                        </div>
                        <div class="card-footer-action">
                            <span>Explore Seasons</span> <i class="fa-solid fa-arrow-right"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SmartOne Bottom TV Footer -->
            <footer class="smartone-footer">
                <div class="footer-left">
                    <span class="server-status-dot"></span>
                    <span>Service: <strong id="server-name-display">ROCH Tv</strong></span>
                </div>
                <div class="footer-center">
                    <div class="remote-key-guide">
                        <span class="key-badge"><kbd>◄ ►</kbd> Navigate</span>
                        <span class="key-badge"><kbd>OK</kbd> Select</span>
                        <span class="key-badge"><kbd>ESC</kbd> Return</span>
                    </div>
                </div>
                <div class="footer-right">
                    <span class="license-by-badge"><i class="fa-solid fa-certificate"></i> license
                        by:ichiban_kuriosaki</span>
                    <span class="smartone-app-version"><i class="fa-solid fa-shield-halved"></i> Roch TV v2.1</span>
                </div>
            </footer>
        </div>

        <!-- ================= THEME 2: HOTEL IPTV SOLUTION ================= -->
        <div id="theme2-dashboard-view" class="theme-dashboard-layout theme2-layout" style="display:none;">
            <!-- Wallpaper Background with Sunset Pool Villa -->
            <div class="hotel-theme-bg" style="background-image: url('img/theme2_bg.jpg');">
                <canvas id="hotel-canvas" class="dashboard-canvas"></canvas>
            </div>
            <div class="hotel-theme-overlay"></div>

            <!-- Top Header -->
            <header class="hotel-theme-header">
                <!-- Top-Left Branding Matching User Screenshot -->
                <div class="hotel-brand-wrap" id="hotel-brand-wrap">
                    <div class="hotel-logo-row" id="hotel-logo-row-container">
                        <div class="hotel-equalizer-badge" id="hotel-eq-badge">
                            <div class="eq-col">
                                <span class="eq-dot"></span>
                                <span class="eq-line"></span>
                            </div>
                            <div class="eq-col">
                                <span class="eq-line"></span>
                                <span class="eq-dot"></span>
                            </div>
                            <div class="eq-col">
                                <span class="eq-dot"></span>
                                <span class="eq-line"></span>
                            </div>
                        </div>
                        <div class="hotel-brand-text" id="hotel-brand-text-display">
                            <span style="color:#ffffff; font-weight:900;">BR</span><span
                                style="color:#22c55e; font-weight:800; font-size:1.1rem; line-height:0.8; margin-top:-6px; display:inline-block;">itt</span><span
                                style="color:#22c55e; font-weight:600; margin-left:2px;">oadcast</span>
                        </div>
                    </div>
                    <img id="hotel-custom-logo-img" src="" alt="Brand Logo"
                        style="display:none; max-height:48px; max-width:240px; object-fit:contain; filter:drop-shadow(0 2px 8px rgba(0,0,0,0.8)); margin-bottom:4px;">
                    <div class="hotel-solution-subtitle" id="hotel-solution-subtitle-display">Hotel IPTV Solution</div>
                </div>

                <!-- Top-Right Prominent Date & Huge Digital Clock (Matching Picture) -->
                <div class="hotel-clock-wrap">
                    <div class="hotel-date-col">
                        <div class="hotel-full-date" id="hotel-clock-date">8 March 2024</div>
                        <div class="hotel-day-name" id="hotel-clock-day">FRIDAY</div>
                    </div>
                    <div class="hotel-big-time" id="hotel-clock-time">12:53</div>
                </div>
            </header>

            <!-- Main Interactive Tile Grid -->
            <div class="hotel-main-container">
                <div class="hotel-grid-wrapper">

                    <!-- Spotlight Card: ROOM 102 - About Hotel (Left Column, Full 2-Row Height) -->
                    <div class="hotel-spotlight-card" id="theme2-card-room" tabindex="0"
                        onclick="handleTheme2TileAction('room_info')"
                        style="background-image: url('img/theme2_room.jpg');">
                        <div class="spotlight-header-overlay">
                            <div class="spotlight-room-number" id="hotel-display-room">ROOM NOC</div>
                            <div class="spotlight-room-sub" id="hotel-display-room-sub">About Hotel</div>
                        </div>
                        <div class="spotlight-footer-hint">
                            <i class="fa-solid fa-circle-info"></i> Resort & Concierge Info
                        </div>
                    </div>

                    <!-- Center & Right Multi-Tile Cluster (Matching Picture) -->
                    <div class="hotel-tiles-cluster" id="hotel-tiles-cluster-container">

                        <!-- Row 1: TV, MOVIES, SERIES (Dedicated), WEATHER, DINING -->
                        <div class="hotel-tiles-row hotel-row-top" id="hotel-tiles-row-1">

                            <!-- Tile 1: TV (Live TV) -->
                            <div class="hotel-tile tile-tv" id="theme2-tile-tile_tv" data-tile-id="tile_tv" tabindex="0"
                                onclick="handleTheme2TileAction('livetv')">
                                <div class="tile-icon-holder">
                                    <i class="fa-solid fa-tv"></i>
                                </div>
                                <div class="tile-label">TV</div>
                            </div>

                            <!-- Tile 2: MOVIES (Golden film reels photo) -->
                            <div class="hotel-tile tile-photo tile-movies" id="theme2-tile-tile_movies"
                                data-tile-id="tile_movies" tabindex="0" onclick="handleTheme2TileAction('movies')"
                                style="background-image: url('img/theme2_movies.jpg');">
                                <div class="tile-photo-scrim"></div>
                                <div class="tile-label">MOVIES</div>
                            </div>

                            <!-- Tile 3: SERIES (Dedicated Cinema Clapper & Film reels photo) -->
                            <div class="hotel-tile tile-photo tile-series" id="theme2-tile-tile_series"
                                data-tile-id="tile_series" tabindex="0" onclick="handleTheme2TileAction('series')"
                                style="background-image: url('img/theme2_series.jpg');">
                                <div class="tile-photo-scrim"></div>
                                <div class="tile-label">SERIES</div>
                            </div>

                            <!-- Tile 4: WEATHER -->
                            <div class="hotel-tile tile-weather" id="theme2-tile-tile_weather"
                                data-tile-id="tile_weather" tabindex="0" onclick="handleTheme2TileAction('weather')">
                                <div class="tile-icon-holder">
                                    <i class="fa-solid fa-cloud-showers-heavy"></i>
                                </div>
                                <div class="tile-label" id="hotel-weather-temp">+10°C</div>
                            </div>

                            <!-- Tile 5: DINING (Fine dining dish photo) -->
                            <div class="hotel-tile tile-photo tile-wide tile-dining" id="theme2-tile-tile_dining"
                                data-tile-id="tile_dining" tabindex="0" onclick="handleTheme2TileAction('dining')"
                                style="background-image: url('img/theme2_dining.jpg');">
                                <div class="tile-photo-scrim"></div>
                                <div class="tile-label">DINING</div>
                            </div>

                        </div>

                        <!-- Row 2: Store, Bill, Language, Messages, ROOM SERVICES -->
                        <div class="hotel-tiles-row hotel-row-bottom" id="hotel-tiles-row-2">

                            <!-- Tile 6: Store (Favorites / VOD) -->
                            <div class="hotel-tile tile-store" id="theme2-tile-tile_store" data-tile-id="tile_store"
                                tabindex="0" onclick="handleTheme2TileAction('favorites')">
                                <div class="tile-icon-holder">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </div>
                                <div class="tile-label">STORE</div>
                            </div>

                            <!-- Tile 7: Bill (Account & Expiry) -->
                            <div class="hotel-tile tile-bill" id="theme2-tile-tile_bill" data-tile-id="tile_bill"
                                tabindex="0" onclick="handleTheme2TileAction('bill')">
                                <div class="tile-icon-holder">
                                    <i class="fa-solid fa-credit-card"></i>
                                </div>
                                <div class="tile-label">BILL</div>
                            </div>

                            <!-- Tile 8: Language (Settings) -->
                            <div class="hotel-tile tile-language" id="theme2-tile-tile_language"
                                data-tile-id="tile_language" tabindex="0" onclick="handleTheme2TileAction('settings')">
                                <div class="tile-icon-holder">
                                    <i class="fa-solid fa-globe"></i>
                                </div>
                                <div class="tile-label">LANGUAGE</div>
                            </div>

                            <!-- Tile 9: Messages (Broadcast Announcement) -->
                            <div class="hotel-tile tile-messages" id="theme2-tile-tile_messages"
                                data-tile-id="tile_messages" tabindex="0" onclick="handleTheme2TileAction('messages')">
                                <div class="tile-icon-holder">
                                    <i class="fa-solid fa-comment-dots"></i>
                                </div>
                                <div class="tile-label">MESSAGES</div>
                            </div>

                            <!-- Tile 10: ROOM SERVICES (Luxury hotel bed photo) -->
                            <div class="hotel-tile tile-photo tile-wide tile-services"
                                id="theme2-tile-tile_room_services" data-tile-id="tile_room_services" tabindex="0"
                                onclick="handleTheme2TileAction('room_services')"
                                style="background-image: url('img/theme2_bed.jpg');">
                                <div class="tile-photo-scrim"></div>
                                <div class="tile-label">ROOM SERVICES</div>
                            </div>

                        </div>

                    </div>

                </div>
            </div>

            <!-- Bottom Floating Quick Info & License -->
            <footer class="hotel-theme-footer">
                <div class="hotel-footer-left">
                    <span class="hotel-status-pip"></span>
                    <span>High-Speed IPTV Feed Connected</span>
                </div>
                <div class="hotel-footer-center">
                    <span class="hotel-key-tip"><kbd>◄ ▲ ▼ ►</kbd> Navigate</span>
                    <span class="hotel-key-tip"><kbd>OK</kbd> Select</span>
                    <span class="hotel-key-tip"><kbd>ESC</kbd> Return</span>
                </div>
                <div class="hotel-footer-right">
                    <span class="hotel-license"><i class="fa-solid fa-certificate"></i> license
                        by:ichiban_kuriosaki</span>
                </div>
            </footer>
        </div>

        <!-- ================= THEME 3: OTT CINEMA SPOTLIGHT ================= -->
        <div id="theme3-dashboard-view" class="theme-dashboard-layout theme3-layout" style="display:none;">
            <!-- Dynamic Hero Backdrop Image with Cinematic Dark Gradients -->
            <div class="theme3-backdrop-container">
                <img id="theme3-hero-backdrop-img" class="theme3-backdrop-img" src="img/theme3_bg.jpg" alt="Backdrop">
                <div class="theme3-backdrop-gradient"></div>
                <div class="theme3-backdrop-radial"></div>
            </div>

            <!-- Top Navigation Bar Matching Screenshot: Movies, TV Series, Lives, Search, Settings -->
            <header class="theme3-top-navbar" id="theme3-top-navbar">
                <div class="theme3-nav-brand">
                    <img src="img/roch.png" alt="Roch TV" class="theme3-nav-logo" onerror="this.src='img/pbb.png'">
                    <span class="theme3-nav-title">ROCH TV</span>
                </div>

                <nav class="theme3-nav-tabs" id="theme3-nav-tabs">
                    <button type="button" class="theme3-tab-btn active" id="t3-tab-movies" data-tab="movies"
                        onclick="switchTheme3Tab('movies')">Movies</button>
                    <button type="button" class="theme3-tab-btn" id="t3-tab-series" data-tab="series"
                        onclick="switchTheme3Tab('series')">TV Series</button>
                    <button type="button" class="theme3-tab-btn" id="t3-tab-lives" data-tab="lives"
                        onclick="switchTheme3Tab('lives')">Lives</button>
                    <button type="button" class="theme3-tab-btn" id="t3-tab-search" data-tab="search"
                        onclick="openSearchModal()">Search</button>
                    <button type="button" class="theme3-tab-btn" id="t3-tab-settings" data-tab="settings"
                        onclick="openSettingsModal()">Settings</button>
                </nav>

                <div class="theme3-nav-meta">
                    <div class="theme3-live-indicator"><span class="t3-dot"></span> 4K OTT</div>
                    <div class="theme3-nav-clock" id="theme3-nav-clock">12:53</div>
                </div>
            </header>

            <!-- Main Scrollable Content Area -->
            <div class="theme3-main-scroll" id="theme3-main-scroll">

                <!-- Hero Spotlight Info matching Screenshot -->
                <section class="theme3-hero-spotlight" id="theme3-hero-spotlight">
                    <!-- Vertical Movie Poster Card -->
                    <div class="theme3-spotlight-poster-card" id="theme3-spotlight-poster-card">
                        <img id="t3-spotlight-poster"
                            src="https://image.tmdb.org/t/p/w500/AkJQvtRUr8IfBs23vL65udKRqGk.jpg" alt="Poster"
                            onerror="this.src='img/theme3_bg.jpg'">
                        <div class="t3-poster-glass-edge"></div>
                    </div>

                    <!-- Metadata Details, Release, Duration, Cast, Genre, Synopsis -->
                    <div class="theme3-spotlight-info">
                        <h1 id="t3-spotlight-title" class="theme3-spotlight-title">MISSION: IMPOSSIBLE - FALLOUT</h1>

                        <div class="theme3-meta-strip">
                            <span id="t3-spotlight-release" class="t3-badge-release">July 2018</span>
                            <span class="t3-meta-divider">&bull;</span>
                            <span id="t3-spotlight-duration" class="t3-badge-duration">Duration: 148 min</span>
                            <span class="t3-meta-divider">&bull;</span>
                            <span class="t3-badge-res">4K ULTRA HD</span>
                        </div>

                        <div class="theme3-credits-grid">
                            <div class="t3-credit-row">
                                <span class="t3-credit-label">Cast:</span>
                                <span id="t3-spotlight-cast" class="t3-credit-value">Tom Cruise, Henry Cavill, Ving
                                    Rhames, Simon Pegg</span>
                            </div>
                            <div class="t3-credit-row">
                                <span class="t3-credit-label">Genre:</span>
                                <span id="t3-spotlight-genre" class="t3-credit-value">Action, Thriller, Adventure</span>
                            </div>
                        </div>

                        <p id="t3-spotlight-synopsis" class="theme3-spotlight-synopsis">
                            When an IMF mission ends badly, the world is faced with dire consequences. As Ethan Hunt
                            takes it upon himself to fulfill his original briefing, the CIA begin to question his
                            loyalty and his motives. The IMF team find themselves in a race against time, hunted by
                            assassins while trying to prevent a global catastrophe.
                        </p>

                        <!-- Action Buttons -->
                        <div class="theme3-hero-buttons">
                            <button type="button" class="t3-btn-primary" id="t3-btn-watch"
                                onclick="handleTheme3WatchCurrent()">
                                <i class="fa-solid fa-play"></i> Watch Now
                            </button>
                            <button type="button" class="t3-btn-glass" onclick="handleTheme3OpenDetails()">
                                <i class="fa-solid fa-circle-info"></i> Details
                            </button>
                            <button type="button" class="t3-btn-glass" id="t3-btn-fav-toggle"
                                onclick="handleTheme3ToggleFav()">
                                <i class="fa-solid fa-heart"></i> Favorite
                            </button>
                            <button type="button" class="t3-btn-glass" onclick="openSection('Movies')" title="Browse Full Movies Catalog">
                                <i class="fa-solid fa-film"></i> All Movies
                            </button>
                        </div>
                    </div>
                </section>

                <!-- Lower Content Rows: LIVES, MOVIES, and TV SERIES -->
                <section class="theme3-carousels-container">

                    <!-- Row 1: LIVE CHANNELS & FAVORITES -->
                    <div class="theme3-carousel-row" id="theme3-row-favorites">
                        <div class="theme3-row-header" onclick="openSection('Live TV')" style="cursor:pointer;" title="Click to view all live channels">
                            <h3 class="theme3-row-title"><i class="fa-solid fa-satellite-dish" style="color:#38bdf8; margin-right:6px;"></i> LIVE CHANNELS &amp; FAVORITES</h3>
                            <span class="theme3-row-count" id="t3-count-fav"><i class="fa-solid fa-arrow-right"></i> View All Channels</span>
                        </div>
                        <div class="theme3-poster-strip" id="theme3-strip-favorites" tabindex="0">
                            <!-- Populated dynamically via JavaScript with active highlight -->
                        </div>
                    </div>

                    <!-- Row 2: PRIMA FILA VOD (MOVIES) -->
                    <div class="theme3-carousel-row" id="theme3-row-primafila">
                        <div class="theme3-row-header" onclick="openSection('Movies')" style="cursor:pointer;" title="Click to view all movies">
                            <h3 class="theme3-row-title"><i class="fa-solid fa-film" style="color:#eab308; margin-right:6px;"></i> PRIMA FILA VOD (MOVIES)</h3>
                            <span class="theme3-row-count" id="t3-count-primafila"><i class="fa-solid fa-arrow-right"></i> View All Movies</span>
                        </div>
                        <div class="theme3-poster-strip" id="theme3-strip-primafila" tabindex="0">
                            <!-- Populated dynamically via JavaScript -->
                        </div>
                    </div>

                    <!-- Row 3: POPULAR TV SERIES -->
                    <div class="theme3-carousel-row" id="theme3-row-series">
                        <div class="theme3-row-header" onclick="openSection('Series')" style="cursor:pointer;" title="Click to view all series">
                            <h3 class="theme3-row-title"><i class="fa-solid fa-tv" style="color:#a855f7; margin-right:6px;"></i> POPULAR TV SERIES</h3>
                            <span class="theme3-row-count" id="t3-count-series"><i class="fa-solid fa-arrow-right"></i> View All Series</span>
                        </div>
                        <div class="theme3-poster-strip" id="theme3-strip-series" tabindex="0">
                            <!-- Populated dynamically via JavaScript -->
                        </div>
                    </div>

                </section>
            </div>

            <!-- TV Remote Control Key Guide Footer -->
            <footer class="theme3-footer-guide">
                <div class="t3-guide-left">
                    <span class="t3-status-dot"></span>
                    <span>Roch TV OTT Cloud Stream &bull; Low Latency HLS</span>
                </div>
                <div class="t3-guide-center">
                    <span class="t3-kbd-pill"><kbd>◄ ▲ ▼ ►</kbd> Navigate</span>
                    <span class="t3-kbd-pill"><kbd>OK</kbd> Select / Play</span>
                    <span class="t3-kbd-pill"><kbd>ESC</kbd> Return</span>
                </div>
                <div class="t3-guide-right">
                    <span><i class="fa-solid fa-shield-halved"></i> Roch TV Cinema Edition</span>
                </div>
            </footer>
        </div>

    </div>

    <!-- CONTENT SCREEN (Channels/Movies/Series) -->
    <div id="content-screen" class="screen">
        <header class="top-bar">
            <div class="back-btn" tabindex="0" role="button" onclick="goBack()">
                <i class="fa-solid fa-arrow-left"></i> Back
            </div>
            <h2 id="section-title">Section</h2>
            <div class="search-container" style="position: relative; display: flex; align-items: center;">
                <i class="fa-solid fa-magnifying-glass"
                    style="position: absolute; left: 12px; color: var(--text-muted);"></i>
                <input type="text" id="search-input" placeholder="Search..." oninput="filterItems()"
                    style="padding: 8px 15px 8px 35px; border-radius: 20px; border: 1px solid var(--glass-border); background: rgba(0,0,0,0.5); color: white; outline: none; width: 220px;">
            </div>
        </header>

        <div class="split-view">
            <div class="categories-sidebar" id="categories-list">
                <!-- Populated by JS -->
            </div>
            <div class="items-view" id="items-list">
                <!-- Populated by JS -->
            </div>
        </div>
        <footer class="content-bottom-bar">
            <div class="content-bottom-left">
                <kbd>Back</kbd> Return to Dashboard
            </div>
            <div class="content-bottom-right">
                <i class="fa-solid fa-certificate"></i> license by:ichiban_kuriosaki
            </div>
        </footer>
    </div>

    <!-- EPISODES OVERLAY -->
    <div id="episodes-overlay" class="overlay">
        <div class="player-header">
            <div class="close-player" onclick="closeEpisodes()">
                <i class="fa-solid fa-arrow-left"></i>
            </div>
            <h3 id="episodes-title">Series Name</h3>
        </div>
        <div class="episodes-container" id="episodes-list"
            style="flex:1; overflow-y:auto; padding: 20px; background: var(--bg-color);">
            <!-- Populated by JS -->
        </div>
    </div>

    <!-- PLAYER OVERLAY (Enhanced Suite: Sleep Timer, Favorites, Audio/CC Tracks, Aspect Ratio, Quick Zap) -->
    <div id="player-overlay" class="overlay">
        <div class="player-header">
            <div class="player-header-left">
                <button type="button" class="player-back-btn" onclick="closePlayer()" title="Back / Exit (Esc)">
                    <i class="fa-solid fa-arrow-left"></i>
                </button>
                <div class="player-title-box">
                    <span id="player-section-tag" class="player-badge-tag">LIVE TV</span>
                    <h3 id="player-title">Now Playing</h3>
                </div>
            </div>

            <div class="player-header-actions">
                <!-- Previous Channel Recall -->
                <button type="button" id="btn-player-recall" class="player-action-btn" onclick="recallPreviousChannel()"
                    title="Previous Channel (Q / Zap)" style="display:none;">
                    <i class="fa-solid fa-rotate-left"></i>
                    <span class="btn-text">Recall</span>
                </button>

                <!-- Favorite Star Toggle -->
                <button type="button" id="btn-player-fav" class="player-action-btn"
                    onclick="toggleCurrentPlayingFavorite()" title="Add to Favorites (F)">
                    <i class="fa-regular fa-star"></i>
                    <span class="btn-text" id="player-fav-text">Favorite</span>
                </button>

                <!-- Aspect Ratio Switcher -->
                <button type="button" id="btn-player-aspect" class="player-action-btn"
                    onclick="cyclePlayerAspectRatio()" title="Aspect Ratio (A)">
                    <i class="fa-solid fa-expand"></i>
                    <span class="btn-text" id="aspect-ratio-label">Fit</span>
                </button>

                <!-- Audio, Subtitles & Quality Track Menu -->
                <div class="player-dropdown-wrap">
                    <button type="button" id="btn-player-tracks" class="player-action-btn"
                        onclick="togglePlayerTracksMenu(event)" title="Audio & Subtitles (S)">
                        <i class="fa-solid fa-sliders"></i>
                        <span class="btn-text">Tracks</span>
                    </button>
                    <div id="player-tracks-menu" class="player-popover-menu" style="display:none;">
                        <div class="popover-section-header">
                            <i class="fa-solid fa-headphones"></i> Audio Language
                        </div>
                        <div id="player-audio-tracks-list" class="popover-options-list">
                            <div class="popover-item active">Default Audio</div>
                        </div>

                        <div class="popover-section-header">
                            <i class="fa-solid fa-closed-captioning"></i> Subtitles & CC
                        </div>
                        <div id="player-subs-tracks-list" class="popover-options-list">
                            <div class="popover-item active">Off</div>
                        </div>

                        <div class="popover-section-header">
                            <i class="fa-solid fa-gear"></i> Stream Quality
                        </div>
                        <div id="player-quality-tracks-list" class="popover-options-list">
                            <div class="popover-item active">Auto (Optimal)</div>
                        </div>
                    </div>
                </div>

                <!-- TV Sleep Timer -->
                <div class="player-dropdown-wrap">
                    <button type="button" id="btn-player-sleep" class="player-action-btn"
                        onclick="togglePlayerSleepMenu(event)" title="TV Sleep Timer">
                        <i class="fa-solid fa-moon"></i>
                        <span class="btn-text" id="player-sleep-label">Sleep</span>
                    </button>
                    <div id="player-sleep-menu" class="player-popover-menu" style="display:none;">
                        <div class="popover-section-header">
                            <i class="fa-solid fa-clock"></i> TV Sleep Timer
                        </div>
                        <div class="popover-options-list" id="player-sleep-options">
                            <div class="popover-item active" data-mins="0" onclick="setSleepTimer(0)">Off (Disabled)
                            </div>
                            <div class="popover-item" data-mins="15" onclick="setSleepTimer(15)">15 Minutes</div>
                            <div class="popover-item" data-mins="30" onclick="setSleepTimer(30)">30 Minutes</div>
                            <div class="popover-item" data-mins="45" onclick="setSleepTimer(45)">45 Minutes</div>
                            <div class="popover-item" data-mins="60" onclick="setSleepTimer(60)">60 Minutes (1 Hour)
                            </div>
                            <div class="popover-item" data-mins="90" onclick="setSleepTimer(90)">90 Minutes (1.5 Hours)
                            </div>
                            <div class="popover-item" data-mins="120" onclick="setSleepTimer(120)">120 Minutes (2 Hours)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sleep countdown pill if active -->
                <div id="player-sleep-countdown-pill" class="sleep-countdown-badge" style="display:none;"
                    onclick="togglePlayerSleepMenu(event)" title="Sleep Timer Active - Click to Change">
                    <i class="fa-solid fa-moon"></i> <span id="sleep-countdown-text">30:00</span>
                </div>

                <!-- Close Button -->
                <div class="close-player" onclick="closePlayer()" title="Close Player (Esc)">
                    <i class="fa-solid fa-xmark"></i>
                </div>
            </div>
        </div>

        <div class="video-container" id="video-container" onclick="dismissPlayerMenus(event)"
            oncontextmenu="return false;">
            <video id="video-player" controls controlsList="nodownload noplaybackrate" disablePictureInPicture
                disableRemotePlayback autoplay playsinline class="aspect-fit" oncontextmenu="return false;">
                Your browser does not support the video tag.
            </video>

            <!-- Quick Aspect Ratio / Status Toast HUD -->
            <div id="player-status-toast" class="player-toast" style="display:none;">
                <span id="player-toast-text">Aspect Ratio: Fit (Contain)</span>
            </div>

            <!-- TV Sleep Screen (Active when timer completes) -->
            <div id="player-sleep-screen" class="player-sleep-overlay" style="display:none;" onclick="wakeFromSleep()">
                <div class="sleep-screen-card" onclick="event.stopPropagation()">
                    <div class="sleep-icon-moon"><i class="fa-solid fa-moon fa-bounce"></i></div>
                    <h2>TV Sleep Timer Activated</h2>
                    <p>Playback was safely paused to conserve your bandwidth and sleep peacefully.</p>
                    <button type="button" class="btn-wake-up" onclick="wakeFromSleep()">
                        <i class="fa-solid fa-play"></i> Wake Up & Resume
                    </button>
                    <div class="sleep-wake-tip">Or press any key on remote / tap screen to wake</div>
                </div>
            </div>
        </div>
    </div>

