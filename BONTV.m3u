            </div>

            <div class="modal-body" style="padding: 20px 24px;">
                <div class="ios-feature-banner">
                    <div class="ios-banner-badge"><i class="fa-solid fa-shield-halved"></i> 100% UNREVOKABLE</div>
                    <h4 style="margin: 6px 0 4px; color: #fff; font-size: 1rem;">Roch TV Native App for Apple iOS</h4>
                    <p style="font-size: 0.8rem; color: #cbd5e1; margin: 0; line-height: 1.4;">
                        Install <strong>Roch TV directly onto your iPhone or iPad Home Screen</strong>. Works across
                        <strong>all iOS versions (iOS 12 through iOS 18+)</strong> with full-screen hardware streaming.
                    </p>
                </div>

                <!-- Official Apple App Store Style Badge Button (Downloads Roch TV iOS) -->
                <div style="margin: 18px 0; text-align: center;">
                    <a href="download-ios.php" onclick="triggerIosRochDownload(event)" class="btn-apple-store-download"
                        id="btn-apple-store-roch"
                        style="min-width: 270px; justify-content: center; cursor: pointer; text-decoration: none;">
                        <i class="fa-brands fa-apple" style="font-size: 2.2rem; color: #fff;"></i>
                        <div style="text-align: left;">
                            <div
                                style="font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.85;">
                                Download on the</div>
                            <div
                                style="font-size: 1.25rem; font-weight: 800; line-height: 1.1; letter-spacing: -0.01em;">
                                Apple App Store</div>
                        </div>
                    </a>
                    <div id="ios-auto-dl-notice"
                        style="margin-top: 10px; font-size: 0.84rem; color: #38bdf8; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 8px;">
                        <i class="fa-solid fa-circle-check" style="color: #22c55e;"></i> Roch TV iOS download ready!
                        Follow the 3 steps below:
                    </div>
                </div>

                <div class="ios-steps-list">
                    <div class="ios-step-item">
                        <div class="step-num">1</div>
                        <div class="step-content">
                            <div class="step-title">Tap Download &amp; Allow</div>
                            <div class="step-desc">Tap <strong>"Allow"</strong> on the prompt in Safari, or tap the
                                <strong>Apple App Store</strong> button above to download.
                            </div>
                        </div>
                    </div>
                    <div class="ios-step-item">
                        <div class="step-num">2</div>
                        <div class="step-content">
                            <div class="step-title">Open iPhone Settings</div>
                            <div class="step-desc">Open the <strong>Settings</strong> app on your iPhone/iPad. Tap
                                <strong style="color:#38bdf8;">"Profile Downloaded"</strong> at the top of the menu.
                            </div>
                        </div>
                    </div>
                    <div class="ios-step-item">
                        <div class="step-num">3</div>
                        <div class="step-content">
                            <div class="step-title">Tap Install &amp; Enjoy</div>
                            <div class="step-desc">Tap <strong>"Install"</strong> in the top-right corner. The
                                <strong>Roch TV app icon</strong> will instantly appear on your Home Screen!
                            </div>
                        </div>
                    </div>
                </div>

                <div
                    style="margin-top: 14px; background: rgba(255,255,255,0.04); border: 1px dashed rgba(255,255,255,0.15); border-radius: 12px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; gap: 10px;">
                    <div style="overflow: hidden;">
                        <span
                            style="font-size: 0.72rem; color: #94a3b8; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Or
                            Add via Safari Home Screen</span>
                        <div id="ios-pwa-url-display"
                            style="font-size: 0.86rem; color: #38bdf8; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px;">
                            --</div>
                    </div>
                    <button type="button" class="btn-copy-chip" onclick="copyIosPwaUrl()" id="btn-copy-pwa-url"
                        style="flex-shrink:0;">
                        <i class="fa-regular fa-copy"></i> <span>Copy Link</span>
                    </button>
                </div>
            </div>

            <div class="modal-footer"
                style="padding: 14px 24px; border-top: 1px solid rgba(255, 255, 255, 0.08); display: flex; justify-content: space-between; align-items: center;">
                <div style="font-size: 0.75rem; color: #64748b;">
                    <i class="fa-solid fa-circle-check" style="color: #22c55e;"></i> Fully Tested on iOS 12 — iOS 18+
                </div>
                <button type="button" class="btn-modal-save" onclick="closeIosInstallModal()">Close Guide</button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <script src="js/dynamic-bg.js?v=65"></script>
    <script src="js/app.js?v=65"></script>
</body>

</html>
