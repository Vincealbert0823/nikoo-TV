                            style="background:rgba(0,0,0,0.4); border:1px dashed rgba(255,255,255,0.15); border-radius:10px; padding:12px 16px; display:flex; align-items:center; justify-content:space-between; margin-top:6px;">
                            <div>
                                <span style="font-size:0.75rem; color:#888;">Last Detected Remote Key:</span>
                                <div id="key-tester-display"
                                    style="font-size:0.95rem; font-weight:700; color:#fff; margin-top:2px;">Waiting for
                                    remote key press...</div>
                            </div>
                            <div id="key-tester-indicator"
                                style="width:12px; height:12px; border-radius:50%; background:#444;"></div>
                        </div>
                    </div>
                </div>

                <!-- TAB 4: STORAGE & HEALTH -->
                <div id="mgmt-tab-storage" class="mgmt-tab-content">
                    <div class="setting-group">
                        <label class="setting-label"><i class="fa-solid fa-hard-drive"></i> Cache & Playlist
                            Health</label>
                        <div class="account-summary-box">
                            <div class="account-row"><span>In-Memory Client Cache:</span> <strong
                                    id="mgmt-mem-cache-count">Active (0 entries)</strong></div>
                            <div class="account-row"><span>Saved Favorites:</span> <strong id="mgmt-fav-count">0
                                    items</strong></div>
                            <div class="account-row"><span>Account Status:</span> <span class="badge-status-ok"
                                    id="modal-account-status">Active</span></div>
                            <div class="account-row"><span>Account Expiry:</span> <strong
                                    id="modal-account-expiry">Unlimited</strong></div>
                        </div>
                    </div>

                    <div style="display:flex; gap:10px; margin-top:16px;">
                        <button type="button" onclick="purgeSystemCache()"
                            style="flex:1; padding:12px; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15); border-radius:10px; color:#fff; font-weight:600; cursor:pointer; font-size:0.85rem;">
                            <i class="fa-solid fa-trash-can" style="margin-right:6px;"></i> Purge Server Cache
                        </button>
                        <button type="button" onclick="resetSystemToDefaults()"
                            style="flex:1; padding:12px; background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.3); border-radius:10px; color:#fca5a5; font-weight:600; cursor:pointer; font-size:0.85rem;">
                            <i class="fa-solid fa-power-off" style="margin-right:6px;"></i> Factory Reset
                        </button>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
