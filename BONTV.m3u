                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <div>
                                <label class="setting-label" style="color:#38bdf8; margin:0;"><i
                                        class="fa-solid fa-cloud-arrow-down"></i> OTA System & App Updater</label>
                                <p class="setting-hint" style="margin:4px 0 0 0;">Check for new software updates for
