                            <button type="button" onclick="checkAppUpdatesManual()"
                                style="background:#38bdf8; color:#000; font-weight:700; font-size:0.82rem; padding:8px 14px; border:none; border-radius:8px; cursor:pointer; display:inline-flex; align-items:center; gap:6px;">
                                <i class="fa-solid fa-arrows-rotate"></i> Check for Updates
